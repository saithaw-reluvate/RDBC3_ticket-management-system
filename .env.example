# Copy to .env and fill in real values. .env is gitignored.

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=ticket_system
POSTGRES_USER=ticket_system
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Email — Mailpit in development
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=support@example.com

# Step 2 — backend API
FRONTEND_BASE_URL=http://localhost:3000
TICKET_TOKEN_TTL_DAYS=90
ATTACHMENT_MAX_BYTES=5242880
ATTACHMENT_MAX_COUNT=5
