# Used as the build context for backend/Dockerfile (context: .), so the
# backend image build doesn't send the whole repo — venvs, node_modules,
# and generated artifacts in particular.

.git
.gitignore

# Python
backend/.venv
backend/.pytest_cache
backend/.coverage
backend/media
backend/staticfiles
**/__pycache__
*.py[cod]

# Logs
logs

# Env
.env
.env.*
!.env.example

# Node / Next.js — not needed for the backend image at all
frontend/node_modules
frontend/.next
frontend/out
frontend/playwright-report
frontend/test-results

# Docs / misc — not needed inside the backend image
docs
README.md
