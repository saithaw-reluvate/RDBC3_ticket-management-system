# Copy to .env.local for local dev. .env*.local is gitignored.

# Used by next.config.mjs rewrites (browser -> Next.js -> Django) and by
# Server Components for direct server-side fetches (docs/FRONTEND.md §10).
# Local dev (backend run via `manage.py runserver`, not Docker): localhost.
# Inside Docker Compose (Step 5): the backend service name, e.g. http://backend:8000.
BACKEND_ORIGIN=http://localhost:8000

# Step 4 E2E suite (playwright.config.ts / e2e/global-setup.ts). All optional
# — sensible dev defaults are baked in. Override only if your backend venv,
# Mailpit, or the E2E admin password differ from the project defaults.
# E2E_BACKEND_PYTHON=/absolute/path/to/backend/.venv/bin/python
# E2E_MAILPIT_URL=http://localhost:8025
# E2E_ADMIN_PASSWORD=E2eDevOnly!2026
# E2E_BASE_URL=http://localhost:3000
